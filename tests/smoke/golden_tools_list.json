{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "readOnlyHint": false
      },
      "description": "Adds keywords to an ad group.",
      "inputSchema": {
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer id, digits only."
          },
          "ad_group_id": {
            "type": "string",
            "description": "Ad group id."
          },
          "keywords": {
            "items": {
              "description": "A keyword to add.",
              "properties": {
                "text": {
                  "description": "Keyword text, e.g. 'running shoes'.",
                  "type": "string"
                },
                "match_type": {
                  "default": "PHRASE",
                  "enum": [
                    "EXACT",
                    "PHRASE",
                    "BROAD"
                  ],
                  "type": "string"
                },
                "cpc_bid_micros": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional keyword-level max CPC in micros (1 unit = 1,000,000)."
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            },
            "type": "array",
            "description": "Keywords to add, each with text, match_type and optional bid."
          },
          "status": {
            "default": "PAUSED",
            "enum": [
              "ENABLED",
              "PAUSED"
            ],
            "type": "string",
            "description": "Status of new keywords. Defaults to PAUSED."
          },
          "validate_only": {
            "default": true,
            "type": "boolean",
            "description": "When true (default), validate without applying."
          }
        },
        "required": [
          "customer_id",
          "ad_group_id",
          "keywords"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "name": "add_keywords",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
