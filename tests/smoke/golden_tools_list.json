    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "readOnlyHint": false
      },
      "description": "Creates a Search campaign with its own daily budget, using manual CPC.\n\nBudget and campaign are created atomically. Targets Google Search and the\nSearch Network, not the Display Network.",
      "inputSchema": {
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer id, digits only."
          },
          "name": {
            "type": "string",
            "description": "Campaign name; must be unique in the account."
          },
          "daily_budget_micros": {
            "type": "integer",
            "description": "Daily budget in micros (1 unit = 1,000,000)."
          },
          "status": {
            "default": "PAUSED",
            "enum": [
              "ENABLED",
              "PAUSED"
            ],
            "type": "string",
            "description": "Defaults to PAUSED."
          },
          "contains_eu_political_advertising": {
            "default": false,
            "type": "boolean",
            "description": "Required declaration. Defaults to false."
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional YYYY-MM-DD."
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional YYYY-MM-DD."
          },
          "validate_only": {
            "default": true,
            "type": "boolean",
            "description": "When true (default), validate without applying."
          }
        },
        "required": [
          "customer_id",
          "name",
          "daily_budget_micros"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "name": "create_search_campaign",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
